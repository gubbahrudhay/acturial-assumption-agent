# Backend Environment Configuration
# ===============================

# [NETWORK] The port FastAPI binds to
PORT=8000

# [NETWORK] The host IP FastAPI binds to (use 0.0.0.0 for Docker)
HOST=0.0.0.0

# [AI ENGINE] The Google Gemini API Key used for the Planner and Investigation workflows
# Obtain this from Google AI Studio. Do NOT commit the actual key to source control.
GEMINI_API_KEY=your_gemini_api_key_here
